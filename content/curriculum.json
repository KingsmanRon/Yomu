{
  "$schema": "./schema/curriculum.schema.json",
  "levels": [
    {
      "level": 0,
      "title": "Home-language reading bridge",
      "description": "Decoding in isiZulu or Sesotho first: home-language vowels, syllables and first words, then carrying the skill into English. Optional; offered when the placement shows the learner cannot yet decode in their home language.",
      "aetLevel": "pre-aet"
    },
    {
      "level": 1,
      "title": "Foundations",
      "description": "English letter recognition, phonemic awareness, letter-sound relationships and first letter formation.",
      "aetLevel": "aet-1"
    },
    {
      "level": 2,
      "title": "First words",
      "description": "Blending sounds into words, word identification, spelling with tiles, picture matching and common sight words.",
      "aetLevel": "aet-1"
    },
    {
      "level": 3,
      "title": "Sentences",
      "description": "Reading simple sentences, building sentences and basic comprehension.",
      "aetLevel": "aet-1"
    },
    {
      "level": 4,
      "title": "Everyday English",
      "description": "Reading SMS messages, signs, notices and other everyday texts, and typing short replies.",
      "aetLevel": "aet-2"
    },
    {
      "level": 5,
      "title": "Independent reading",
      "description": "Reading short passages, answering questions and writing short responses.",
      "aetLevel": "aet-2"
    }
  ],
