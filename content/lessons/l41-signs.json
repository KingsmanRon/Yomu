  "intro": {
    "zu": {
      "id": "zu.l41-signs.intro",
      "text": "Izimpawu zisitshela okufanele sikwenze nokuthi sihlale siphephile. Eziningi zibhalwe ngezinhlamvu ezinkulu.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l41-signs.intro",
      "text": "Matshwao a re bolella seo re lokelang ho se etsa le ho dula re bolokehile. A mangata a ngotswe ka ditlhaku tse kgolo.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l41-signs.outro",
      "text": "Kuhle! Manje uyakwazi ukufunda izimpawu ezibalulekile emsebenzini nasedolobheni.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l41-signs.outro",
      "text": "Ho hotle! Jwale o kgona ho bala matshwao a bohlokwa mosebetsing le toropong.",
      "review": {
        "status": "draft"
      }
    }
