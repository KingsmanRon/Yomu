  "target": "en",
  "title": {
    "en": "Reading a simple SMS",
    "zu": {
      "id": "zu.l40-sms.title",
      "label": "Funda i-SMS",
      "text": "Funda i-SMS elula: isikhumbuzo se-appointment, noma i-airtime iphansi.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l40-sms.title",
      "label": "Bala SMS",
      "text": "Bala SMS e bonolo: kgopotso ya appointment, kapa airtime e tlase.",
      "review": {
        "status": "draft"
      }
    }
  },
  "summary": "Reading short SMS messages (appointment reminder, low airtime, order ready) for sender, day and time; typing a short reply.",
  "objectives": [
    {
      "id": "obj.l40.read-sms",
      "description": "Read a short SMS and find key information: who sent it, what it is about, which day and what time.",
      "strand": "functional_reading",
      "masteryCompetencies": [
        "decode",
        "understand_written"
      ],
      "reading": true,
      "aet": [
        {
          "level": "aet-2",
          "outcome": "aet.2.functional-reading"
        }
      ]
    },
    {
      "id": "obj.l40.type-reply",
      "description": "Type a short reply (OK, yes) on the phone keyboard.",
      "strand": "writing",
      "masteryCompetencies": [
        "write"
      ],
      "reading": false,
      "aet": [
        {
          "level": "aet-2",
          "outcome": "aet.2.functional-writing"
        }
      ]
    }
  ],
  "prerequisites": [
    "obj.l30.read-sentences"
  ],
