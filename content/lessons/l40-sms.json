      "line": {
        "zu": {
          "id": "zu.l40-sms.t04",
          "text": "I-SMS ivame ukuqala ngegama lalowo oyithumele. Lapha kuthi Clinic: umtholampilo.",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l40-sms.t04",
          "text": "SMS hangata e qala ka lebitso la ya e rometseng. Mona ho re Clinic: tliliniki.",
          "review": {
            "status": "draft"
          }
        }
      },
      "showText": "Clinic: Your appointment is on Monday at 9:00."
    },
