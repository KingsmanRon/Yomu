  "intro": {
    "zu": {
      "id": "zu.l40-sms.intro",
      "text": "Ama-SMS asitshela izinto ezibalulekile: umtholampilo, ibhange, isitolo. Namuhla sizofunda ukuthola ulwazi olubalulekile ku-SMS.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l40-sms.intro",
      "text": "Di-SMS di re bolella dintho tsa bohlokwa: tliliniki, banka, lebenkele. Kajeno re tla ithuta ho fumana tlhahisoleseding ya bohlokwa ho SMS.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l40-sms.outro",
      "text": "Wenze kahle! Manje uyakwazi ukufunda i-SMS nokuthola ukuthi ivela kubani nokuthi kunini.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l40-sms.outro",
      "text": "O entse hantle! Jwale o kgona ho bala SMS le ho fumana hore e tswa ho mang le hore ke neng.",
      "review": {
        "status": "draft"
      }
    }
  }
