    "en": "Tracing and writing your first English letters",
    "zu": {
      "id": "zu.l12-tracing.title",
      "label": "Bhala izinhlamvu",
      "text": "Landela futhi ubhale izinhlamvu zakho zokuqala zesiNgisi.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l12-tracing.title",
      "label": "Ngola ditlhaku",
      "text": "Latela mme o ngole ditlhaku tsa hao tsa pele tsa Senyesemane.",
      "review": {
        "status": "draft"
      }
    }
  },
  "summary": "Letter formation by touch tracing (t, i, n, p, a, s) and first typing of letters and a word on the phone keyboard.",
  "objectives": [
    {
      "id": "obj.l12.write-letters",
      "description": "Form the lower-case letters t, i, n, p, a and s by tracing in the right stroke order.",
      "strand": "writing",
      "masteryCompetencies": [
        "write"
      ],
      "reading": false,
      "aet": [
        {
          "level": "aet-1",
          "outcome": "aet.1.write-letters-words"
        }
      ]
    },
    {
      "id": "obj.l12.type-letters",
      "description": "Find and type letters and a short word on the phone keyboard.",
