  "intro": {
    "zu": {
      "id": "zu.l12-tracing.intro",
      "text": "Namuhla sizobhala. Uzolandela izinhlamvu ngomunwe wakho esikrinini. Qala echashazini eliluhlaza.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l12-tracing.intro",
      "text": "Kajeno re tla ngola. O tla latela ditlhaku ka monwana wa hao skrineng. Qala lethebeng le letala.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l12-tracing.outro",
      "text": "Wenze kahle! Ubhale izinhlamvu zakho zokuqala zesiNgisi. Qhubeka uprakthize ukubhala.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l12-tracing.outro",
      "text": "O entse hantle! O ngotse ditlhaku tsa hao tsa pele tsa Senyesemane. Tswela pele ho ikwetlisa ho ngola.",
      "review": {
        "status": "draft"
      }
    }
  }
