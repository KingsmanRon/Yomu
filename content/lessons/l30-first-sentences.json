    },
    {
      "id": "l30-first-sentences.e06",
      "type": "sentence_build",
      "objectives": [
        "obj.l30.build-sentences"
      ],
      "instructionClip": "instr.build_sentence",
      "target": "en.sen.i-am-at-work",
      "tiles": [
        "work.",
        "I",
        "am",
        "you",
        "at"
      ]
    },
    {
      "id": "l30-first-sentences.e07",
      "type": "picture_match",
      "objectives": [
        "obj.l30.read-sentences"
      ],
      "instructionClip": "instr.read_sentence_picture",
      "mode": "read",
      "target": "en.sen.the-bus-is-here",
      "options": [
        "en.sen.the-cat-is-here",
        "en.sen.you-can-sit-here",
        "en.sen.the-bus-is-here"
      ]
    },
    {
      "id": "l30-first-sentences.e08",
      "type": "listening_comprehension",
      "objectives": [
        "obj.l30.listen-sentences"
      ],
      "instruction": {
        "zu": {
          "id": "zu.l30-first-sentences.e08.instr",
          "text": "Lalela umusho. Uphi lo muntu? Thinta isithombe.",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l30-first-sentences.e08.instr",
          "text": "Mamela polelo. Motho enwa o kae? Tobetsa setshwantsho.",
          "review": {
            "status": "draft"
          }
        }
      },
      "audio": "en.sen.i-am-at-work",
      "question": {
        "zu": {
          "id": "zu.l30-first-sentences.e08.q",
          "text": "Uphi lo muntu?",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l30-first-sentences.e08.q",
          "text": "Motho enwa o kae?",
          "review": {
            "status": "draft"
          }
        }
      },
      "options": [
        {
          "id": "bus",
          "image": "bus"
        },
        {
          "id": "work",
          "image": "work"
        },
        {
          "id": "clinic",
          "image": "clinic"
        }
      ],
      "answer": "work"
    },
    {
      "id": "l30-first-sentences.e09",
      "type": "reading_comprehension",
      "objectives": [
        "obj.l30.read-sentences"
      ],
      "instruction": {
        "zu": {
          "id": "zu.l30-first-sentences.e09.instr",
          "text": "Funda umusho, bese uphendula umbuzo.",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l30-first-sentences.e09.instr",
          "text": "Bala polelo, ebe o araba potso.",
          "review": {
            "status": "draft"
          }
        }
      },
      "passage": "en.sen.the-cat-is-here",
      "question": {
        "zu": {
          "id": "zu.l30-first-sentences.e09.q",
          "text": "Yini ekhona lapha?",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l30-first-sentences.e09.q",
          "text": "Ke eng e leng mona?",
          "review": {
            "status": "draft"
          }
        }
      },
      "options": [
        {
          "id": "dog",
          "image": "dog"
        },
        {
          "id": "cat",
          "image": "cat"
