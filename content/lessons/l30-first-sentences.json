  ],
  "intro": {
    "zu": {
      "id": "zu.l30-first-sentences.intro",
      "text": "Usuyakwazi ukufunda amagama. Manje sizowahlanganisa abe imisho. Umusho uqala ngohlamvu olukhulu, uphele ngechashazi.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l30-first-sentences.intro",
      "text": "O se o kgona ho bala mantswe. Jwale re tla a kopanya ho etsa dipolelo. Polelo e qala ka tlhaku e kgolo, e fele ka kgutlo.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l30-first-sentences.outro",
      "text": "Wenze kahle kakhulu! Ufunde imisho yakho yokuqala yesiNgisi.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l30-first-sentences.outro",
      "text": "O entse hantle haholo! O balile dipolelo tsa hao tsa pele tsa Senyesemane.",
      "review": {
        "status": "draft"
      }
    }
  }
}
