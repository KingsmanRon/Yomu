  "intro": {
    "zu": {
      "id": "zu.l50-job-notice.intro",
      "text": "Izaziso zemisebenzi zinolwazi olubalulekile. Funda isaziso kancane, umugqa ngamunye, bese uphendula imibuzo.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l50-job-notice.intro",
      "text": "Ditsebiso tsa mesebetsi di na le tlhahisoleseding ya bohlokwa. Bala tsebiso butle, mola ka mong, ebe o araba dipotso.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l50-job-notice.outro",
      "text": "Wenze kahle kakhulu! Ufunde isaziso somsebenzi wedwa, wabhala nezimpendulo.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l50-job-notice.outro",
      "text": "O entse hantle haholo! O balile tsebiso ya mosebetsi o le mong, mme wa ngola le dikarabo.",
      "review": {
        "status": "draft"
      }
    }
