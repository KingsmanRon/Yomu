  "intro": {
    "zu": {
      "id": "zu.l00-hl-vowels.intro",
      "text": "Uyakwazi kakade ukukhuluma isiZulu. Manje sizofunda izinhlamvu ezibhala imisindo oyaziyo. Siqala ngonkamisa abahlanu: a, e, i, o, u.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l00-hl-vowels.intro",
      "text": "O se o kgona ho bua Sesotho. Jwale re tla ithuta ditlhaku tse ngolang medumo eo o e tsebang. Re qala ka ditlhaku tse hlano: a, e, i, o, u.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l00-hl-vowels.outro",
      "text": "Wenze kahle! Manje wazi onkamisa abahlanu. Esifundweni esilandelayo sizobahlanganisa nezinye izinhlamvu.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l00-hl-vowels.outro",
      "text": "O entse hantle! Jwale o tseba ditlhaku tsena tse hlano. Thutong e latelang re tla di kopanya le ditlhaku tse ding.",
      "review": {
        "status": "draft"
      }
    }
  }
