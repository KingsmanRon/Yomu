    "zu": {
      "id": "zu.l00-hl-vowels.title",
      "label": "Izinhlamvu ozaziyo",
      "text": "Izinhlamvu nemisindo osuyikhuluma kakade.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l00-hl-vowels.title",
      "label": "Ditlhaku tseo o di tsebang",
      "text": "Ditlhaku le medumo eo o seng o e bua.",
      "review": {
        "status": "draft"
      }
    }
  },
  "summary": "Home-language vowels a, e, i, o, u: matching letters to sounds and hearing vowels in familiar words.",
  "objectives": [
    {
      "id": "obj.l00.hl-vowels",
      "description": "See a home-language vowel letter (a, e, i, o, u) with no audio and choose its sound.",
      "strand": "home_language_bridge",
      "masteryCompetencies": [
        "decode"
      ],
      "reading": true,
      "aet": [
        {
          "level": "pre-aet",
          "outcome": "aet.pre.hl-letter-sounds"
        }
      ]
    },
    {
      "id": "obj.l00.hl-hear-vowels",
      "description": "Hear a home-language vowel, alone or inside a familiar word, and find its letter.",
