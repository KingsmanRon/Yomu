  "intro": {
    "zu": {
      "id": "zu.l11-inmd.intro",
      "text": "Siqhubeka nezinhlamvu ezine ezintsha: i, n, m, d. Bese sifunda uhlamvu c, oluzwakala ngendlela ehlukile esiNgisini.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l11-inmd.intro",
      "text": "Re tswela pele ka ditlhaku tse nne tse ntjha: i, n, m, d. Ebe re ithuta tlhaku c, e utlwahalang ka tsela e fapaneng ho Senyesemane.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l11-inmd.outro",
      "text": "Kuhle! Manje wazi i, n, m, d, futhi uyazi ukuthi u-c esiNgisini uzwakala njengo-k.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l11-inmd.outro",
      "text": "Ho hotle! Jwale o tseba i, n, m, d, mme o a tseba hore c ho Senyesemane e utlwahala jwalo ka k.",
      "review": {
        "status": "draft"
      }
    }
  }
