      "line": {
        "zu": {
          "id": "zu.l11-inmd.t05",
          "text": "Manje uhlamvu c. EsiZulwini u-c uyaqhafaza, njengasegameni elithi icici. EsiNgisini, egameni elithi cat, u-c akaqhafazi: uzwakala njengo-k.",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l11-inmd.t05",
          "text": "Jwale tlhaku c. Ho Senyesemane, lentsweng cat, c e utlwahala jwalo ka k. Ha e utlwahale jwalo ka modumo wa q wa Sesotho.",
          "review": {
            "status": "draft"
          }
        }
      },
      "letter": "en.l.c"
    },
    {
