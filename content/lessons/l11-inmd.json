  "title": {
    "en": "English letter sounds: i, n, m, d (and c)",
    "zu": {
      "id": "zu.l11-inmd.title",
      "label": "i, n, m, d",
      "text": "Imisindo yesiNgisi: i, n, m, d, kanye no-c.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l11-inmd.title",
      "label": "i, n, m, d",
      "text": "Medumo ya Senyesemane: i, n, m, d, le c.",
      "review": {
        "status": "draft"
      }
    }
  },
  "summary": "Letter sounds i, n, m, d, and the letter c as /k/, with explicit attention to home-language click letters.",
  "objectives": [
    {
      "id": "obj.l11.inmd-letters",
      "description": "See the letters i, n, m and d (alone and in short words) and choose their English sounds.",
