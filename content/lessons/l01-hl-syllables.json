{
  "$schema": "../schema/lesson.schema.json",
  "id": "l01-hl-syllables",
  "version": 1,
  "level": 0,
  "unit": "u0",
  "order": 2,
  "minutes": 5,
  "target": "home",
  "title": {
    "en": "Building syllables and reading your first home-language words",
    "zu": {
      "id": "zu.l01-hl-syllables.title",
      "label": "Amagama okuqala",
      "text": "Sakha izingxenye zamagama, sifunde amagama okuqala ngesiZulu.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l01-hl-syllables.title",
      "label": "Mantswe a pele",
      "text": "Re aha dikarolo tsa mantswe, re bala mantswe a pele ka Sesotho.",
      "review": {
        "status": "draft"
      }
    }
  },
  "summary": "Blending a consonant and a vowel into syllables, then reading and building familiar home-language words.",
  "objectives": [
    {
      "id": "obj.l01.hl-syllables",
      "description": "Blend a consonant and a vowel into a syllable (ma, ba, mi, bu) and read it with no audio.",
      "strand": "home_language_bridge",
      "masteryCompetencies": [
        "decode"
      ],
      "reading": true,
      "aet": [
        {
          "level": "pre-aet",
          "outcome": "aet.pre.hl-decoding"
        }
      ]
    },
    {
      "id": "obj.l01.hl-words",
      "description": "Read simple, familiar home-language words with no audio and match them to pictures.",
      "strand": "home_language_bridge",
      "masteryCompetencies": [
        "decode",
        "understand_written"
      ],
      "reading": true,
      "aet": [
        {
          "level": "pre-aet",
          "outcome": "aet.pre.hl-decoding"
        }
      ]
    },
    {
      "id": "obj.l01.hl-build",
      "description": "Build a familiar home-language word from its syllables after hearing it.",
      "strand": "writing",
      "masteryCompetencies": [
        "write"
      ],
      "reading": false,
      "aet": [
        {
          "level": "pre-aet",
          "outcome": "aet.pre.hl-decoding"
        }
      ]
    }
  ],
  "prerequisites": [
    "obj.l00.hl-vowels"
  ],
  "contrastiveTags": [],
  "steps": [
    {
      "id": "l01-hl-syllables.t01",
      "teach": "explain",
      "line": {
        "zu": {
          "id": "zu.l01-hl-syllables.t01",
          "text": "Bheka: m kanye no-a kwenza ma. Lalela: mmm, a, ma.",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l01-hl-syllables.t01",
          "text": "Sheba: m le a di etsa ma. Mamela: mmm, a, ma.",
          "review": {
            "status": "draft"
          }
        }
      },
      "showText": "m + a = ma"
    },
    {
      "id": "l01-hl-syllables.t02",
      "teach": "explain",
      "line": {
        "zu": {
          "id": "zu.l01-hl-syllables.t02",
          "text": "Futhi b kanye no-a kwenza ba. Lalela: b, a, ba.",
          "review": {
            "status": "draft"
          }
        },
        "st": {
          "id": "st.l01-hl-syllables.t02",
          "text": "Hape b le a di etsa ba. Mamela: b, a, ba.",
          "review": {
            "status": "draft"
          }
        }
      },
      "showText": "b + a = ba"
    },
