  "intro": {
    "zu": {
      "id": "zu.l01-hl-syllables.intro",
      "text": "Uhlamvu nonkamisa kuyahlangana kwakhe ingxenye yegama, njengo-m no-a benza ma. Izingxenye zakha amagama.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l01-hl-syllables.intro",
      "text": "Tlhaku le e nngwe ya ditlhaku tse hlano di kopana ho etsa karolo ya lentswe, jwalo ka m le a di etsa ma. Dikarolo di aha mantswe.",
      "review": {
        "status": "draft"
      }
    }
  },
  "outro": {
    "zu": {
      "id": "zu.l01-hl-syllables.outro",
      "text": "Uyafunda manje! Ufunde amagama esiZulu. Lelo khono lizokusiza nasesiNgisini.",
      "review": {
        "status": "draft"
      }
    },
    "st": {
      "id": "st.l01-hl-syllables.outro",
      "text": "Jwale o a bala! O balile mantswe a Sesotho. Bokgoni boo bo tla o thusa le ho Senyesemane.",
      "review": {
        "status": "draft"
      }
    }
  }
