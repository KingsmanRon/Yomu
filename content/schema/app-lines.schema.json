{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "lines"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": {
          "type": "string"
        },
        "zu": {
          "$ref": "#/$defs/__schema1"
        },
        "st": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "id",
        "description",
        "zu",
        "st"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(zu|st|en)\\.[a-z0-9][a-z0-9._-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/$defs/__schema2"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/$defs/__schema2"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "native_speaker",
                      "adult_literacy_educator",
                      "linguist",
                      "aet_specialist",
                      "voice_director"
                    ]
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "role",
                  "date"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "text",
        "review"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "draft",
        "native_speaker_reviewed",
        "educator_reviewed",
        "approved"
      ]
    }
  },
  "$id": "https://yomu.invalid/content/schema/app-lines.schema.json",
  "title": "Yomu content: app-lines"
}
