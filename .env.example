# Copy to .env.local for local development.

# --- Supabase -------------------------------------------------------------
# For local development, take the two keys from `npx supabase status -o env`
# (PUBLISHABLE_KEY and SECRET_KEY) after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Product ----------------------------------------------------------------
# The product name lives in src/config/app.ts; this optional override is for white-label pilots.
# NEXT_PUBLIC_APP_NAME=Yomu
# Show the amber "unreviewed content" marker (default true while content is draft).
NEXT_PUBLIC_SHOW_REVIEW_MARKERS=true
# Production: ship only lessons whose every line is approved (build time).
HIDE_UNAPPROVED_CONTENT=false

# --- Secrets for hashing (server only) -------------------------------------
# Random strings of at least 32 characters in production.
PIN_PEPPER=dev-only-pin-pepper-change-me-0123456789
CRON_SECRET=dev-only-cron-secret

# --- AI tutor (server only). Learners only ever see capabilities marked
# verified in config/capabilities.json; everything else falls back to Tier 1.
# Providers: "dev" (deterministic development adapter), "anthropic", "vulavula", "none".
AI_LLM_PROVIDER=dev
AI_STT_PROVIDER=dev
AI_TTS_PROVIDER=none
ANTHROPIC_API_KEY=
AI_LLM_MODEL=claude-haiku-5-5
VULAVULA_API_KEY=
# Hard cap on AI spend per UTC day, across all learners.
AI_DAILY_SPEND_CAP_USD=5
AI_RATE_LIMIT_PER_MINUTE=6
AI_RATE_LIMIT_PER_DAY=60
TUTOR_LOG_RETENTION_DAYS=90

# --- Analytics (pseudonymous, no personal data, no audio) -------------------
ANALYTICS_ENABLED=true
NEXT_PUBLIC_ANALYTICS_ENABLED=true
