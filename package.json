{
  "name": "yomu",
  "version": "0.1.0",
  "private": true,
  "description": "Yomu: a mobile-first English literacy tutor for adults, taught through isiZulu or Sesotho.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run content:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:schema": "tsx scripts/export-schema.ts",
    "content:pull-reviews": "tsx scripts/pull-reviews.ts",
    "audio:manifest": "tsx scripts/export-audio-manifest.ts",
    "audio:import": "tsx scripts/import-audio.ts",
    "audio:placeholders": "tsx scripts/generate-placeholder-audio.ts",
    "docs:aet": "tsx scripts/generate-aet-alignment.ts",
    "db:seed-content": "tsx scripts/seed-content.ts",
    "perf:lighthouse": "tsx scripts/perf-lighthouse.ts",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "idb": "8.0.4",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.6",
    "lighthouse": "13.5.0",
    "pg": "8.23.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
